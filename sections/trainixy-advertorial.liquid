    { "type": "text", "id": "price_text", "label": "Starting price", "default": "$24.99" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "See today’s bundle options" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "checkbox", "id": "noindex", "label": "Hide from search engines while reviewing", "default": true }
  ],
  "presets": [{ "name": "Trainixy advertorial" }]
}
{% endschema %}
