<script>
  (function () {
    var root = document.getElementById('TxAdv-{{ section.id }}');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    document.body.classList.add('tx-advertorial-page');

    var params = window.location.search;
    if (params) {
      root.querySelectorAll('[data-product-link]').forEach(function (link) {
        var url = new URL(link.href, window.location.origin);
        var incoming = new URLSearchParams(params);
        incoming.forEach(function (value, key) { url.searchParams.set(key, value); });
        link.href = url.toString();
      });
    }

    var progress = root.querySelector('[data-progress]');
    var sticky = root.querySelector('[data-sticky]');
    var offers = Array.prototype.slice.call(root.querySelectorAll('[data-offer]'));
    function update() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.width = (max > 0 ? Math.min(100, window.scrollY / max * 100) : 0) + '%';
      var offerVisible = offers.some(function (offer) {
        var rect = offer.getBoundingClientRect();
        return rect.top < window.innerHeight && rect.bottom > 0;
      });
      sticky.hidden = !(window.scrollY > window.innerHeight * 0.9 && !offerVisible);
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  })();
</script>

