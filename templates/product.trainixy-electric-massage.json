    "trustpilot_reviews_2_j9AFFL": {
      "type": "trustpilot-reviews-2",
      "blocks": {
        "slide_jaXiKe": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "A little spa moment! 😍",
            "text": "I didn’t expect to use it this often, but now it’s part of my weekly hair routine. It feels relaxing, gentle, and makes my scalp feel refreshed after a long day. Such a simple tool, but it really makes self-care feel more enjoyable.",
            "author_date": "Cathrine"
          }
        },
        "slide_X3Thdc": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "Perfect after work! ✨",
            "text": "After sitting at my desk all day, this feels so soothing on my scalp. I usually use it for a few minutes before bed, and it helps me unwind so easily. It feels comfortable to hold and makes my evening routine feel much more relaxing.",
            "author_date": "Megan"
          }
        },
        "slide_pEmeLk": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "My wash day upgrade! 💆‍♀️",
            "text": "I started using it when shampooing and honestly love the feeling. The massage nodes feel soft, not harsh, and it makes washing my hair feel more like a salon treatment. I didn’t know I needed this until I tried it.",
            "author_date": "Lauren"
          }
        },
        "slide_8KnJxj": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "So gentle on my hair! 😍",
            "text": "I was initially hesitant to switch from my usual brand to this new one, but I'm so glad I did! This product has exceeded my expectations. It's not only affordable but also incredibly efficient. The quality is top-notch, and it's user-friendly.",
            "author_date": "Jessica"
          }
        },
        "slide_LbWX9Y": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "Love it with scalp oil! ✨",
            "text": "This makes my scalp oil routine feel so much better. It helps spread the oil more evenly and makes the whole process feel cleaner, easier, and more relaxing. I actually look forward to using it during my self-care nights now.",
            "author_date": "Rachel"
          }
        },
        "slide_iQ8Kfj": {
          "type": "slide",
          "settings": {
            "stars_count": 5,
            "heading": "Feels amazing! 💕",
            "text": "I bought it just to try something new for my hair care routine, and I’m so glad I did. It feels calming, lightweight, and easy to use. A few minutes with this feels like a mini head spa at home.",
            "author_date": "Stephanie"
          }
        }
      },
